msgstr "Μη έγκυρη μορφή εξαγωγής."

msgid "Permission denied."
msgstr "Δεν επιτρέπεται η πρόσβαση."

msgid "Security check failed."
msgstr "Ο έλεγχος ασφαλείας απέτυχε."

msgid "File upload failed. Please try again."
msgstr "Η μεταφόρτωση αρχείου απέτυχε. Δοκιμάστε ξανά."

msgid "The file is too large (max 5 MB)."
msgstr "Το αρχείο είναι πολύ μεγάλο (έως 5 MB)."

msgid "Unsupported file type. Use .json, .csv, .bib or .bibtex."
msgstr "Μη υποστηριζόμενος τύπος αρχείου. Χρησιμοποιήστε .json, .csv, .bib ή .bibtex."

msgid "The uploaded file was empty."
msgstr "Το αρχείο που μεταφορτώθηκε ήταν κενό."

msgid "Could not read any publications from the file."
msgstr "Δεν ήταν δυνατή η ανάγνωση δημοσιεύσεων από το αρχείο."

msgid "Import complete: %1$d created, %2$d updated, %3$d failed."
msgstr "Η εισαγωγή ολοκληρώθηκε: %1$d δημιουργήθηκαν, %2$d ενημερώθηκαν, %3$d απέτυχαν."

msgid "Import publications from a file exported by this plugin. Supported formats: JSON, CSV, and BibTeX. Existing publications are matched by DOI, then BibTeX key, then slug &mdash; matches are updated, everything else is created."
msgstr "Εισαγωγή δημοσιεύσεων από αρχείο που εξήχθη από αυτό το πρόσθετο. Υποστηριζόμενες μορφές: JSON, CSV και BibTeX. Οι υπάρχουσες δημοσιεύσεις αντιστοιχίζονται με DOI, μετά κλειδί BibTeX, μετά slug &mdash; οι αντιστοιχίες ενημερώνονται, όλα τα άλλα δημιουργούνται."

msgid "Accepted file types: .json, .csv, .bib, .bibtex (max 5 MB)."
msgstr "Αποδεκτοί τύποι αρχείων: .json, .csv, .bib, .bibtex (έως 5 MB)."

msgid "Custom field selection (for \"Export Publications (Custom)\")"
msgstr "Επιλογή προσαρμοσμένων πεδίων (για \"Εξαγωγή δημοσιεύσεων (Προσαρμοσμένη)\")"

msgid "Tick the fields you want to include when using the Custom export button. Ignored when using \"All Fields\"."
msgstr "Επιλέξτε τα πεδία που θέλετε να συμπεριλάβετε κατά την προσαρμοσμένη εξαγωγή. Αγνοείται με \"Όλα τα πεδία\"."

msgid "Custom export requires at least one field to be selected."
msgstr "Η προσαρμοσμένη εξαγωγή απαιτεί την επιλογή τουλάχιστον ενός πεδίου."

msgid "If you changed the Team CPT (the slug setting above, or team-member permalinks), click this to re-link each author to the matching team member in the current Team CPT (by name) and refresh the cached URLs used by Bricks Builder."
msgstr "Αν αλλάξατε το Team CPT (τη ρύθμιση slug παραπάνω ή τους μόνιμους συνδέσμους των μελών), κάντε κλικ εδώ για να επανασυνδέσετε κάθε συγγραφέα με το αντίστοιχο μέλος της ομάδας στο τρέχον Team CPT (βάσει ονόματος) και να ανανεώσετε τις αποθηκευμένες URL που χρησιμοποιεί το Bricks Builder."

msgid "Unsupported import format."
msgstr "Μη υποστηριζόμενη μορφή εισαγωγής."

msgid "No publications found in the uploaded file."
msgstr "Δεν βρέθηκαν δημοσιεύσεις στο αρχείο που μεταφορτώθηκε."

msgid "Skipped a record with no title."
msgstr "Παραλείφθηκε εγγραφή χωρίς τίτλο."

msgid "Failed to save publication."
msgstr "Αποτυχία αποθήκευσης δημοσίευσης."

msgid "The uploaded file is not valid JSON."
msgstr "Το αρχείο που μεταφορτώθηκε δεν είναι έγκυρο JSON."

msgid "The uploaded CSV file is empty or invalid."
msgstr "Το αρχείο CSV που μεταφορτώθηκε είναι κενό ή μη έγκυρο."
